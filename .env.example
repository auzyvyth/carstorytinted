# Copy to .env.local for dev; set the same keys in Vercel > Project > Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public half of the push keypair (npx web-push generate-vapid-keys). NEVER change once staff have subscribed.
VITE_VAPID_PUBLIC_KEY=
# The live domain, no trailing slash. Turns on canonical URLs + sitemap.xml.
SITE_URL=https://www.example.com
